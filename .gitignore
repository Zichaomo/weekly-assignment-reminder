# ── 敏感凭据：绝不能提交 ──────────────────────────
# webhook 的 key= 就是群发口令，任何人拿到都能往群里发消息
data/config.json
# 登录会话（CAS 票据 TGC / JSESSIONID），能直接进你的北化在线账号
data/storage_state.json

# ── 截图与录屏：含个人课程表 / 班级群内容 / 同学姓名 ──
# 2026-10-18 事故：一次 `git add -A` 把「图片/」里的控制台截图一起推到了公开仓库。
# 那些图里有本机课程名与课程编号，属于个人数据，不该进公开仓库。
图片/
截图/
screenshots/
*.gif

# ── 运行时数据（本地状态，不是代码）────────────────
data/hw.json
data/manual.json
data/last_message.txt
data/login_result.png
data/login-normal.html
data/_notify_payload.txt

# ── 调试产物 ──────────────────────────────────────
data/debug/
tests/artifacts/

# ── WorkBuddy 会话数据（含项目记忆 / 账号信息，属本地私有）──
.workbuddy/

# ── Python / 打包 ─────────────────────────────────
__pycache__/
*.pyc
*.zip

# ── 系统垃圾 ──────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── 本次新增的本地状态（账号相关，不进仓库）────────
# 课程索引：含你账号下的课程编号与名称，各人不同；用「刷新课程表」自行生成
data/courses.json
# 黑名单：你的个人取舍，不该强加给 clone 的人
data/course_blacklist.json
data/test_blacklist.json
# 选修课名单：照抓但不进班级群（各自选修不同，属个人取舍）
data/electives.json
# 个人小群那条提醒的正文（含选修课，本地记录）
data/last_message_personal.txt
# 推送台账：含消息首行的本地记录
data/push_log.jsonl
# 抓取互斥锁（运行时文件）
data/scrape.lock
# 所有平台访问锁/任务运行锁（实际默认 data/platform.lock；兼容历史命名）
data/*.lock

# ── 本机权限修复产物（沙箱/ACL 诊断的备份与报告）────────
# 含本机 SID、绝对路径与逐文件清单，只对这台机器有意义
.acl-recovery/
# 每课元数据的自动备份（本地状态）
data/courses.meta.bak.json
# 扫描证据快照（本地状态，候选推导用）
data/courses.scan.json

# 服务端异常日志（排查用）
data/server_error.log

# 服务日志（无窗口运行时的输出）
data/server_console.log
data/server_error.log

# 检索台账（本地记录：抓了什么、多久、失败几门）
data/fetch_log.jsonl

# ── 失败告警（本地记录，各人不同）────────────────────
# 告警台账：每条告警的时间 / 级别 / 内容 / 是否送达
data/alert_log.jsonl
# 告警冷却状态：同类告警在该窗口内只发一次
data/alert_state.json
# 最近一条告警的正文（本机通知与排查用）
data/last_alert.txt

# ── 定时任务（本地记录）──────────────────────────────
# 任务台账：哪次几点跑的、多久、退出码、抓到多少条、发到哪个群
data/task_log.jsonl
# 运行日志：计划任务无窗口，这是唯一的现场
data/task_run.log
# 补推检测日志（登录触发，每次登录都会留下一次判定记录）
data/task_catchup.log

# Local delegation logs and homework cache
.deepastra-work/
data/cache/
data/platform.lock
data/platform-access.lock
